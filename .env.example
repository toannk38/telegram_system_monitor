# ═══ Telegram ═══════════════════════════════════════════════════════════════
BOT_TOKEN=your_bot_token_here
ALERT_CHAT_IDS=123456789
BOT_ALLOWED_USERS=123456789
BOT_ADMIN_USERS=123456789

# ═══ Thu thập & lưu trữ ═════════════════════════════════════════════════════
# Lấy mẫu phụ mỗi SAMPLE_INTERVAL giây, gộp (avg + max) thành 1 dòng CSV mỗi MONITOR_INTERVAL giây
SAMPLE_INTERVAL=5
MONITOR_INTERVAL=60
LOG_DIR=logs
DATA_DIR=data
LOG_RETENTION_DAYS=60
# Phân vùng đo dung lượng (docker-compose tự đặt /host)
DISK_PATH=/

# ═══ Ngưỡng cảnh báo ════════════════════════════════════════════════════════
THRESHOLD_CPU=90.0
THRESHOLD_MEMORY=80.0
THRESHOLD_DISK=90.0
THRESHOLD_TEMP=85.0

# ═══ Chống spam cảnh báo ════════════════════════════════════════════════════
# Số cửa sổ (MONITOR_INTERVAL) liên tiếp vượt ngưỡng mới cảnh báo
ALERT_CONSECUTIVE=3
# Số cửa sổ liên tiếp dưới (ngưỡng - HYSTERESIS) mới báo hồi phục
RECOVERY_CONSECUTIVE=3
ALERT_HYSTERESIS=5
# Nhắc lại khi sự cố kéo dài: 60 → 120 → 240 → 480 phút (0 = không nhắc)
ALERT_REMIND_MINUTES=60
ALERT_REMIND_MAX_MINUTES=480

# ═══ Báo cáo định kỳ ════════════════════════════════════════════════════════
# Giờ gửi báo cáo 24h mỗi ngày (HH:MM, giờ local). Để trống = tắt
DAILY_REPORT_TIME=08:00

# ═══ Giám sát Docker (tuỳ chọn) ═════════════════════════════════════════════
# Bật kết nối Docker: lệnh /docker, /dlogs
DOCKER_MONITOR=false
# Loại sự cố container gây cảnh báo (cần DOCKER_MONITOR=true):
#   true/all = tất cả · false = không cảnh báo (chỉ dùng lệnh)
#   hoặc chọn: unhealthy,crashloop,oom,exit
#     unhealthy = healthcheck báo unhealthy
#     crashloop = container restart liên tục / restart trong DOCKER_RESTART_WINDOW_MINUTES
#     oom       = bị kill do hết RAM
#     exit      = dừng với mã lỗi khác 0 (không tính docker stop)
DOCKER_ALERT=true
# Docker Compose: bật thêm COMPOSE_PROFILES=docker (DOCKER_API_URL được compose đặt sẵn)
# COMPOSE_PROFILES=docker
# systemd: chạy deploy/docker-socket-proxy rồi dùng tcp://127.0.0.1:2375
DOCKER_API_URL=unix:///var/run/docker.sock
# Chỉ theo dõi các container này (trống = tất cả); bỏ qua các container này
DOCKER_WATCH=
DOCKER_IGNORE=
# Cảnh báo nếu container restart trong khoảng thời gian này (phút)
DOCKER_RESTART_WINDOW_MINUTES=10

# ═══ systemd service (chỉ chế độ systemd) ═══════════════════════════════════
# SYSTEMD_SERVICES=nginx,postgresql
SYSTEMD_SERVICES=

# ═══ Kiểm tra endpoint ══════════════════════════════════════════════════════
# name=target, phân tách bằng dấu phẩy. Hỗ trợ http(s)://, tcp://host:port, ping://host
# ENDPOINTS=web=https://example.com,db=tcp://10.0.0.5:5432,gateway=ping://192.168.1.1
ENDPOINTS=
ENDPOINT_TIMEOUT=10

# ═══ Docker only ════════════════════════════════════════════════════════════
# Host user sở hữu ./logs và ./data (kiểm tra bằng `id -u` / `id -g`)
# UID=1000
# GID=1000
